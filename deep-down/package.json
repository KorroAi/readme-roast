{
  "name": "deep-down",
  "private": true,
  "version": "1.0.0",
  "description": "DEEP DOWN - a vertical-descent idle clicker: dig a voxel shaft through fourteen biomes, one tap at a time.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "shots": "node tools/capture.mjs",
    "sim": "node tools/run-ts.mjs tools/econ-sim.ts",
    "preview": "vite preview --host"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/three": "0.186.0",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
