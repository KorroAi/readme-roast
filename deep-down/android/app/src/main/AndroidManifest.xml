<?xml version="1.0" encoding="utf-8"?>
<!-- Base manifest, linkable against the API 23 platform (android/build-apk.sh). The package,
     versions and SDK levels come from the build: build-apk.sh passes them to aapt2, Gradle from
     app/build.gradle.kts. Gradle merges src/modern/AndroidManifest.xml over this file. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- navigator.vibrate in the WebView: short haptics on hits, breaks and pickups (Settings > Vibration). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/DeepDownTheme"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|smallestScreenSize|fontScale|locale|layoutDirection"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
