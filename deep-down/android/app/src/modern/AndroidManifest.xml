<?xml version="1.0" encoding="utf-8"?>
<!-- Gradle manifest overlay (merged over src/main/AndroidManifest.xml for every build type).
     These attributes are newer than the API 23 platform android/build-apk.sh links against:
     - appCategory="game" (API 26): battery and usage grouping as a game;
     - enableOnBackInvokedCallback (API 33): predictive Back through MainActivity's
       OnBackInvokedCallback, registered while the page handles Back;
     - "density" in configChanges (API 24+): display-size changes do not recreate the activity
       (and the WebView with the game in it). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:appCategory="game"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|smallestScreenSize|fontScale|locale|layoutDirection|density"
            tools:replace="android:configChanges" />
    </application>
</manifest>
